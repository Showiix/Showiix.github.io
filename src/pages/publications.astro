---
import fs from "node:fs";
import path from "node:path";
import { createRequire } from "node:module";
import { initSync, parse } from "@retorquere/bibtex-parser";
import BaseLayout from "../layouts/BaseLayout.astro";
import bibtex from "../data/publications.bib?raw";

const SELF = "Jianyu Xu";

const require = createRequire(path.join(process.cwd(), "package.json"));
initSync({ module: fs.readFileSync(require.resolve("@retorquere/bibtex-parser/bibtex_parser_bg.wasm")) });

// english: [] 关掉解析库对标题的大小写改写，保留原文写法
const library = parse(bibtex, { english: [] });
if (library.errors.length > 0) throw new Error(JSON.stringify(library.errors));

const publications = library.entries
  .map((entry) => {
    const f = entry.fields;
    return {
      key: entry.key,
      title: f.title,
      // 作者名末尾的 * 表示通讯作者，# 表示共同第一作者
      authors: f.author.map((a) => {
        const marks = a.lastName.match(/[*#]+$/)?.[0] ?? "";
        const lastName = a.lastName.slice(0, a.lastName.length - marks.length);
        return {
          short: `${lastName} ${a.firstName[0]}.${marks.replaceAll("*", "†").replaceAll("#", "*")}`,
          self: `${a.firstName} ${lastName}` === SELF,
        };
      }),
      venue: f.journal ?? f.booktitle,
      rank: f.description,
      year: Number(f.year),
      month: Number(f.month ?? 0),
      link: f.url ?? (f.doi ? `https://doi.org/${f.doi}` : undefined),
    };
  })
  .sort((a, b) => b.year - a.year || b.month - a.month);

const years = [...new Set(publications.map((p) => p.year))];
---

<BaseLayout title="Publications" sideBarActiveItemID="publications">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Publications</div>
    <div class="mt-8">
      {
        years.map((year) => (
          <>
            <h3 class="text-3xl font-bold mb-4 mt-10">{year}</h3>
            <ul class="space-y-4 text-base">
              {publications
                .filter((p) => p.year === year)
                .map((p) => (
                  <li class="border-l-4 border-primary pl-4">
                    <p>
                      {p.authors.map((a, i) => (
                        <>
                          {a.self ? <b>{a.short}</b> : a.short}
                          {i < p.authors.length - 1 && ", "}
                        </>
                      ))}
                      <br />
                      {p.link ? (
                        <a href={p.link} target="_blank" class="link link-primary">
                          {p.title}
                        </a>
                      ) : (
                        <span>{p.title}</span>
                      )}
                      <br />
                      In <i>{p.venue}</i>{p.rank && <>, (<b>{p.rank}</b>)</>}, {p.year}
                    </p>
                  </li>
                ))}
            </ul>
          </>
        ))
      }
    </div>
  </div>
</BaseLayout>
