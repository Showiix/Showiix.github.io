@article{xu2026care,
  selected={true},
  title = {CARE: Alarm-Side Recalibration of Source-Anchored Shrinkage for Cross-Centre Vital-Sign Forecasting},
  author = {Jianyu Xu and Ruiqi Liu and Xinyi Guo and Dongqing Song* and Chao He*},
  year = {2026},
  journal = {Knowledge-Based Systems},
  description = {KBS · CCF-C · CAS Zone 1 Top · JCR Q1},
  abstract = {Vital-sign forecasts anticipate threshold alarms in surgery and intensive care, and forecasters are usually trained at one centre and deployed at another. We find that, after cross-centre deployment, forecasters with low average error systematically overestimate vital signs during patient deterioration, keeping the forecasts behind low-value alarms above the threshold. We term this phenomenon source-anchored shrinkage. We attribute it to the common practice of training with squared error and deploying the forecaster frozen. Squared error shrinks forecasts toward the population mean, and frozen deployment keeps the anchor of this shrinkage at the source centre, so the bias grows with the level gap between centres. A derivation under a linear-Gaussian model yields this structure, and controlled diagnostics are consistent with it. We therefore propose CARE, an alarm-side recalibration framework under delayed feedback, which keeps the forecaster frozen and learns only alarm-side corrections from matured feedback. First, an analytic head corrects the level bias and shrinkage magnitude anchored at the source centre. Second, a residual revision captures how anchoring varies with patient state and observation density. Finally, a direction gate withholds correction when the bias does not point to the alarm side, so that every existing alarm is preserved. On VitalShift, a cross-centre evaluation covering three public databases and 22 hospitals, CARE effectively mitigates source-anchored shrinkage and reaches the alarm quality of hindsight threshold recalibration without a labelled target-centre calibration set.}
}

@inproceedings{xu2026rasf,
  selected={true},
  title = {RASF: Protocol-Aware Grounding for Cross-Center Vital-Sign Forecasting},
  author = {Jianyu Xu and Ruiqi He and Zicong Huang and Yuhan Jiao and Chao He* and Dongqing Song*},
  year = {2026},
  month = aug,
  booktitle = {Pacific Rim International Conference on Artificial Intelligence (PRICAI)},
  description = {PRICAI 2026 · CCF-C},
  abstract = {Intraoperative vital-sign forecasting is challenged by missing sensors, heterogeneous query settings, and varying recording protocols across hospitals. Existing multivariate time-series models mainly focus on temporal dynamics and cross-variable dependencies. They lack explicit awareness of clinical variable identity, forecasting role, and observation reliability, which limits their robustness when forecasting protocols change. This paper proposes RASF, a Protocol-Aware Staged Grounding Framework for clinical time-series forecasting. RASF grounds each variable in its clinical identity, forecasting role, and observation reliability, providing a unified mechanism for handling missing variables, heterogeneous query settings, and cross-center recording-protocol shifts. A lightweight horizon-conditioning module is further introduced to improve prediction calibration across forecasting horizons. Experiments on VitalBench show that RASF is effective across complete-variable forecasting, variable-subset forecasting, and cross-center transfer. Under the aligned VitalBench protocol, RASF achieves the best performance across the three tracks, reducing MAE by 3.1%, 9.4%, and 2.4% on the complete-variable, variable-subset, and cross-center tracks, respectively. These results highlight the importance of explicitly modeling variable semantics and observation reliability for robust clinical forecasting across heterogeneous healthcare environments.}
}

@misc{song2026prelude,
  selected={true},
  title = {PRELUDE: Separating Common Components from Target-Specific Dependencies for Multivariate Time Series Forecasting},
  author = {Dongqing Song and Jianyu Xu and Haobin Ding and Xinyi Guo and Jiahao Du and Ruiqi He and Ruiqi Liu and Yuntong Xie and Chao He},
  year = {2026},
  month = nov,
  journal = {arXiv preprint arXiv:2611.15155},
  eprint = {2611.15155},
  archivePrefix = {arXiv},
  primaryClass = {cs.LG},
  url = {https://arxiv.org/abs/2611.15155},
  abstract = {Multivariate time series forecasting often improves the prediction of a target by modeling the interactions among variables, and cross-variable modules such as cross-sectional pooling, inter-variable attention, and graph structures are used to construct such interactions. However, by intervening on the cross-variable reading of existing models at inference time, we find that although these models substantially reduce forecasting error through cross-variable interaction, their reading is nearly identical for all targets: the gain appears to come from dependencies among variables but mainly comes from the common component. We term this phenomenon spurious dependency and attribute it to common-component confounding: present in every variable, the common component affects how reading distinguishes sources, so that reading tends to be shared across targets and concentrates on a few similar averages; dependencies thus make up a small share of the read-in content, and a common component composed of several drivers is only partly captured. Theoretical analysis further shows that the common component and dependencies place different requirements on reading and should therefore be handled in different ways. Accordingly, we propose PRELUDE, a separated-reading framework that estimates the common component holistically through cross-sectional pooling and multiple common factors, and reads dependencies for each target via lead-lag relations in the innovation space obtained by prewhitening. Extensive experiments on 16 real-world datasets from four domains show that PRELUDE effectively mitigates spurious dependency and achieves the best overall performance: it attains the best MSE on 23 of the 24 short-horizon and air-quality settings and reduces the average MSE by 6.1% relative to the strongest baseline.}
}

@misc{he2026freshcast,
  selected={true},
  title = {FreshCast: Timely and Complementary Retrieval for Frozen Time Series Forecasters},
  author = {Chao He and Jianyu Xu and Xinyi Guo and Ruiqi Liu and Haobin Ding and Ruiqi He and Yuntong Xie and Dongqing Song},
  year = {2026},
  month = oct,
  journal = {arXiv preprint arXiv:2610.07834},
  eprint = {2610.07834},
  archivePrefix = {arXiv},
  primaryClass = {cs.LG},
  url = {https://arxiv.org/abs/2610.07834},
  abstract = {Retrieval-augmented forecasting for Web and online services supplements a forecaster with the continuations of historical segments that resemble the current context. Most existing methods build the retrieval memory once from the training segment, leaving observations revealed after deployment unavailable as references, and generally do not calibrate how much retrieved information should influence a frozen forecaster. We identify two key determinants of retrieval utility for a frozen forecaster: the timeliness of the retrieved history and its complementarity, i.e., whether the correction it induces aligns with the forecaster's residual errors; this alignment can shift between validation and deployment when the memory becomes stale. We propose FreshCast, a plug-in retrieval framework for frozen forecasters: a non-parametric streaming memory keeps writing in new observations, relational kernel regression weights candidate readouts into a memory forecast, and its correction weight is calibrated in closed form on the validation segment. Under a simplified generative model, we characterize the optimal combination gain through the second-order relation between forecaster error and memory correction, and show that periodic memory information can become redundant once the forecaster captures it. Across seven datasets, ten forecasters, and three input lengths, FreshCast reduces average MSE for every forecaster and input length, by 14.0% and 5.7% at L = 96 and 720, and achieves lower average MSE than the evaluated retrieval-augmented and online updating baselines in their comparison settings. Ablations show that post-training observations are a primary source of the gain: freezing the memory at the end of training removes most of it. For a frozen forecaster, similarity alone is not enough: useful retrieval must stay timely and provide information that the forecaster still misses.}
}
